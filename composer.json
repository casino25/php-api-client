{
    "name": "casino25/php-api-client",
    "homepage": "https://github.com/casino25/php-api-client",
    "description": "Operator API v1 client for PHP.",
    "require": {
        "php": ">=5.6.1",
        "fguillot/json-rpc": "1.2.5",
        "phpseclib/phpseclib": "^2.0",
        "ext-curl": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "casino25\\api\\client\\": "src"
        }
    },
    "require-dev": {
      "phpunit/phpunit": "^5.7",
        "friendsofphp/php-cs-fixer": "^2.19"
    },
    "scripts": {
        "lint": "find src tests -name \"*.php\" -print0 | xargs -0 -n1 php -l",
        "test": "vendor/bin/phpunit tests",
        "check": [
            "@lint",
            "composer validate",
            "@test"
        ],
        "cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix",
        "cs-check": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "platform": {
            "php": "5.6.40"
        }
    }
}
